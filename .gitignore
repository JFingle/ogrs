# Upstream reference clone — read-only, not part of our repo
openrsc-upstream/

# Build output
**/build/
**/out/
**/target/
**/.gradle/
**/bin/
*.class
*.jar
!**/lib/*.jar
*.war

# IDE
.idea/
*.iml
.vscode/
.settings/
.project
.classpath
.factorypath

# OS
.DS_Store
Thumbs.db

# Secrets / local config
.env
.env.local
.env.*.local
**/secrets/
**/conf/server/*.local.conf

# Local DB connection config (creds). Use connections.conf.example as the template.
server/connections.conf

# Runtime-generated server state — local to each install, never committed.
server/ipbans.txt
server/auctionhouse.json
server/avatars/
server/inc/databases/

# Ant build outputs (in addition to *.jar above — these are at server root).
server/core.jar
server/plugins.jar
server/buildplugins/

# Server logs / Backups directory holds runtime DB dumps.
server/logs/*
!server/logs/.gitkeep
server/Backups/*.sql*
!server/Backups/.gitkeep

# Logs
*.log
logs/
**/server/logs/
**/server/Backups/*
!**/server/Backups/.gitkeep

# Database dumps (we ship migrations, not dumps)
*.sql.gz
*.dump

# Generated content from binary-to-JSON map decoder (cache it locally, regenerate from source)
content/zones/_generated/

# Credentials — never commit
**/auth.json
**/*.pem
**/*.key
!**/public.key
